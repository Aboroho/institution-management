# Database
# Direct PostgreSQL connection (Prisma engine). Keep the `postgresql://` scheme: a
# `prisma://` URL selects Prisma Accelerate, which this deployment does not use.
DATABASE_URL="postgresql://ems:ems_secret@localhost:5432/ems?schema=public"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
AUTH_TOKEN_TTL_HOURS="12"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# S3-compatible private object storage (MinIO / AWS S3 / R2)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ems-private"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
# Local fallback when S3 is not configured (dev only)
LOCAL_STORAGE_DIR="./storage"

# Email (SMTP). Leave empty to log emails instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EMS <no-reply@example.com>"

# SMS provider abstraction (log-only unless configured)
SMS_PROVIDER="log"
SMS_API_KEY=""
SMS_SENDER_ID="EMS"

# Seed admin — the ONE protected seed admin (created/claimed by `npm run db:seed`).
# This account is protected by the backend: it cannot change its name, email or
# password through the application and cannot be deleted. Rotate its password with
# SEED_ADMIN_RESET_PASSWORD=true + `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@institution.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_NAME="System Administrator"
# Set to "true" only to rotate the protected seed admin password from the value below.
SEED_ADMIN_RESET_PASSWORD="false"
