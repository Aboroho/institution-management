# Database
DATABASE_URL="postgresql://ems:ems_secret@localhost:5432/ems?schema=public"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
AUTH_TOKEN_TTL_HOURS="12"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# S3-compatible private object storage (MinIO / AWS S3 / R2)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ems-private"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
# Local fallback when S3 is not configured (dev only)
LOCAL_STORAGE_DIR="./storage"

# Email (SMTP). Leave empty to log emails instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EMS <no-reply@example.com>"

# SMS provider abstraction (log-only unless configured)
SMS_PROVIDER="log"
SMS_API_KEY=""
SMS_SENDER_ID="EMS"

# Seed admin
SEED_ADMIN_EMAIL="admin@institution.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_NAME="System Administrator"
